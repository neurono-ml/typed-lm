# syntax=docker/dockerfile:1
#
# Container image for the `typed-lm-trainer` binary (subcommands `train` and
# `quantize`).
#
# Build from the repository root:
#   docker build -f docker/Dockerfile.trainer -t typed-lm-trainer:local .
#
# CPU is the default accelerator. Pass --build-arg FEATURES=cuda to build a
# CUDA image (then run it with `--gpus all` and an NVIDIA container runtime),
# or FEATURES=metal on an Apple Silicon host.

FROM rust:1-trixie AS builder
ARG FEATURES=""
WORKDIR /build
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential cmake pkg-config \
    && rm -rf /var/lib/apt/lists/*
COPY . .
# Drop the repository's host-specific tuning so the image stays portable.
RUN rm -f .cargo/config.toml
RUN cargo build --release -p typed-lm-trainer ${FEATURES:+--features ${FEATURES}}

FROM debian:trixie-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /build/target/release/typed-lm-trainer /usr/local/bin/typed-lm-trainer
ENTRYPOINT ["/usr/local/bin/typed-lm-trainer"]
